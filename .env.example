# PostgreSQL (valores de ejemplo para desarrollo local; no usar en producción)
DB_URL=jdbc:postgresql://localhost:5432/sonido_vivo
DB_USER=sonido
DB_PASSWORD=sonido

# JWT (cambia JWT_SECRET en tu entorno local; no lo subas al repositorio)
JWT_SECRET=cambia-este-secreto-de-ejemplo
JWT_EXPIRATION=3600000

# Orígenes permitidos para CORS (el front de React+Vite corre en este puerto)
CORS_ORIGINS=http://localhost:5173
