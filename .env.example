# Valores de ejemplo. Copia este archivo como .env y reemplaza los placeholders.
# Nunca subas un .env con secretos reales.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL 16 ("db" es el servicio del compose del servidor)
DB_URL=jdbc:postgresql://db:5432/<bd>
DB_USER=<usuario>
DB_PASSWORD=<contraseña>

# JWT: secreto aleatorio de al menos 256 bits, distinto por entorno. Expiración en ms.
JWT_SECRET=<secreto-aleatorio>
JWT_EXPIRATION=3600000

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=<url-del-front>
